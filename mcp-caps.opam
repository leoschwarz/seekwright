opam-version: "2.0"
synopsis: "Capability-gated tool registration for OCaml MCP servers"
description:
  "A small layer over mcp-kit: tools declare the authority their operations need, registration supplies an abstract grant of exactly that type, and policy constructors own filesystem and network confinement."
license: "MIT"
depends: [
  "dune" {>= "3.11"}
  "ocaml" {>= "5.1"}
  "mcp-kit" {= "0.2.0"}
  "eio" {>= "1.6"}
  "yojson" {>= "3.0.0"}
  "uri" {>= "4.0"}
  "eio_main" {with-test}
  "mcp-kit-cohttp-eio" {with-test}
  "cohttp-eio" {>= "6.0"}
  "http" {>= "6.0"}
  "ipaddr" {>= "5.5"}
  "domain-name" {>= "0.4"}
  "tls" {>= "2.0"}
  "tls-eio" {>= "2.0"}
  "ca-certs" {>= "1.0"}
  "mirage-crypto-rng" {>= "1.5"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
