(** AnySearch — keyless whole-web SERP over a JSON API, explicit-only.

    Anonymous mode requires no credentials and cannot bill. Reached only when explicitly named by
    the caller.

    Endpoint: [POST https://api.anysearch.com/v1/search].

    Request [max_results] is clamped to 1–10 per upstream documentation. Supports [language];
    domain, date, and safe-search constraints are dropped.

    402 or 429 indicates quota exhaustion. Fixed error messages are used to prevent leaking
    credentials generated by upstream auto-registration flows. *)

val name : string
(** ["anysearch"], the config key and the [provider] every response names. *)

val endpoint : Uri.t
(** [https://api.anysearch.com/v1/search]. *)

val max_results : int
(** Documented maximum result count (10). *)

val make :
  ?cost_per_1k:float ->
  ?snippet_chars:int ->
  net:Seekwright.Provider.Net.t ->
  unit ->
  Seekwright.Provider.t
(** Constructs the AnySearch provider. *)

val parse : snippet_chars:int -> Yojson.Safe.t -> limit:int -> Seekwright.Provider.hit list
(** Parses hits from [data.results[]]. Shape drift produces an empty list. *)
