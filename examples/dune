(executable
 (name echo)
 ; The M0 baseline: an MCP server built directly on mcp-kit, with no capability
 ; code. The capability plan keeps this path as its fallback, so it stays
 ; runnable through M4 (plans/capability-gated-mcp-server.md §0, §9).
 (libraries mcp-kit mcp-kit.stdio))

(executable
 (name caps_echo)
 ; The same echo tool registered through mcp-caps, so the layer's own path is
 ; exercised end to end over a real transport.
 (libraries mcp-caps mcp-kit mcp-kit.stdio))

(executable
 (name read_source)
 ; The audit surface: a tool registered with a filesystem grant, so the
 ; transport loop has to run inside the Eio loop that opened the subtree.
 ; eio_main is the loop runner and belongs to the example, not to mcp-caps: the
 ; library stays runnable from an application that picks its own loop.
 ; The same server value also serves Streamable HTTP (M2), and the Cohttp-Eio
 ; transport is linked here for the same reason the loop is: transports belong to
 ; the application, never to mcp-caps (plans/capability-gated-mcp-server.md §7).
 (libraries
  mcp-caps
  mcp-kit
  mcp-kit.stdio
  mcp-kit-cohttp-eio
  cohttp-eio
  eio
  eio_main))

(executable
 (name gated_search)
 ; The network authority's audit surface: two tools registered with one [Net]
 ; grant, one of them taking its destination from the caller so the allowlist
 ; refusal is visible from outside. The TLS pieces belong here and not in
 ; mcp-caps' [mcp-caps] library stanza for the same reason the loop does: the
 ; application decides whether it speaks https and which entropy source it uses.
 (libraries
  mcp-caps
  mcp-kit
  mcp-kit.stdio
  mcp-kit-cohttp-eio
  cohttp-eio
  eio
  eio_main
  uri
  mirage-crypto-rng.unix))
