; Startup refusals: exit 1, one sentence on stderr, nothing on stdout, and no
; provider built — so the run reaches no endpoint. The keys rule clears both
; variables it names: a developer shell that holds a real Exa key would
; otherwise start a server on the build machine instead of refusing.
(rule
 (deps ../bin/main.exe cli_startup_keys.toml)
 (targets cli_startup_keys.out cli_startup_keys.err)
 (action
  (with-accepted-exit-codes
   1
   (with-stderr-to cli_startup_keys.err
    (with-stdout-to cli_startup_keys.out
     (run
      sh
      -c
      "env -u SEEKWRIGHT_EXA_API_KEY -u SEEKWRIGHT_PARALLEL_API_KEY SEEKWRIGHT_CONFIG=cli_startup_keys.toml ../bin/main.exe"))))))

(rule
 (alias runtest)
 (action (diff cli_startup_keys.expected cli_startup_keys.err)))

