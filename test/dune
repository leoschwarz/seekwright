(test
 (name test_registry)
 (libraries mcp-caps alcotest))

; The suite may speak mcp-kit: only the library's own core may not.
(test
 (name test_server)
 (libraries mcp-caps mcp-kit yojson alcotest))

; Reads the library's sources, so they have to be in the build sandbox.
(test
 (name test_core_no_mcp_kit)
 (libraries mcp-caps alcotest)
 (deps (glob_files ../lib/caps/*.ml)))

; The filesystem grant is tested against a real backend, so this suite owns an
; Eio loop and uses stdlib Unix to build its fixture tree. Neither belongs to
; mcp-caps itself: the library stays loop-agnostic and Unix-free, which
; test_core_no_mcp_kit.ml guards.
(test
 (name test_authority_fs)
 (libraries mcp-caps alcotest eio eio_main unix))

; Same: this suite serves tools over mcp-kit and builds fixture trees with
; Unix, so it holds a loop and the transport the core itself never names.
(test
 (name test_grant_wiring)
 (libraries mcp-caps mcp-kit yojson alcotest eio eio_main unix))
