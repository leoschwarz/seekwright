 (alias runtest)
 (action (diff no_output.expected cli_startup_keys.out)))

(rule
 (deps ../bin/main.exe cli_startup_primary.toml)
 (targets cli_startup_primary.out cli_startup_primary.err)
 (action
  (with-accepted-exit-codes
   1
   (with-stderr-to cli_startup_primary.err
    (with-stdout-to cli_startup_primary.out
     (run
      sh
      -c
      "SEEKWRIGHT_CONFIG=cli_startup_primary.toml ../bin/main.exe"))))))

(rule
 (alias runtest)
 (action (diff cli_startup_primary.expected cli_startup_primary.err)))

(rule
 (alias runtest)
 (action (diff no_output.expected cli_startup_primary.out)))
