(test
 (name test_error)
 (libraries mcp-caps alcotest))

(test
 (name test_event)
 (libraries mcp-caps alcotest))

(test
 (name test_tool)
 (libraries mcp-caps yojson alcotest))

(test
 (name test_registry)
 (libraries mcp-caps alcotest))

; The suite may speak mcp-kit: only the library's own core may not.
(test
 (name test_server)
 (libraries mcp-caps mcp-kit yojson alcotest))

; Reads the library's sources, so they have to be in the build sandbox.
(test
 (name test_core_no_mcp_kit)
 (libraries mcp-caps alcotest)
 (deps (glob_files ../lib/caps/*.ml)))

; The filesystem grant is tested against a real backend, so this suite owns an
; Eio loop and uses stdlib Unix to build its fixture tree. Neither belongs to
; mcp-caps itself: the library stays loop-agnostic and Unix-free, which
; test_core_no_mcp_kit.ml guards.
(test
 (name test_authority_fs)
 (libraries mcp-caps alcotest eio eio_main unix))

; Same: this suite serves tools over mcp-kit and builds fixture trees with
; Unix, so it holds a loop and the transport the core itself never names.
(test
 (name test_grant_wiring)
 (libraries mcp-caps mcp-kit yojson alcotest eio eio_main unix))

; M2: the same server over Streamable HTTP. This is the only place in the tree
; that runs a cohttp-eio listener and a client, and it uses real loopback TCP
; because that is what the adapter's own bounds (body size, routing headers,
; Origin) are only observable through.
(test
 (name test_http_transport)
 (libraries
  mcp-caps
  mcp-kit
  mcp-kit.stdio
  mcp-kit-cohttp-eio
  cohttp-eio
  http
  yojson
  uri
  eio
  eio_main
  alcotest
  unix))

; M3: the network grant. The fixture is a real loopback HTTP server (so it needs
; the transport and the message model) and a scripted [Eio.Net.t] (so it needs
; [ipaddr] to write addresses down in the form the policy thinks in). Installing
; a random generator belongs to the caller, and that caller-side library needs
; stdlib unix — which is why it is here and not in mcp-caps.
(test
 (name test_authority_net)
 (libraries
  mcp-caps
  alcotest
  eio
  cohttp-eio
  http
  uri
  ipaddr
  cstruct
  mirage-crypto-rng.unix
  eio_main))

; P2: wire models and the sanitize pass. Both are pure, so alcotest and yojson
; are the only libraries.
(test
 (name test_model)
 (libraries seekwright yojson alcotest))

(test
 (name test_sanitize)
 (libraries seekwright yojson alcotest))
