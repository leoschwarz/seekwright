; F1.4: the [--check] disclosure. The config's keys all load and validate;
; this rule pins that the diagnosis says, beside each row and in one
; aggregated list at the end, that the cache, the third-party fetch ladder
; and the private-web widening are not run by this binary. The exit code is
; the problem count, so the rule accepts 1: a key that loads and changes
; nothing is a problem [--check] has to name. Nothing is built under this
; config, so nothing is dialled.
(rule
 (deps ../bin/main.exe check_transitional.toml)
 (targets check_transitional.out check_transitional.err)
 (action
  (with-accepted-exit-codes
   (or
    1
    (not 0))
   (with-stderr-to check_transitional.err
    (with-stdout-to check_transitional.out
     (run
      sh
      -c
      "SEEKWRIGHT_CONFIG=check_transitional.toml ../bin/main.exe --check"))))))

(rule
 (alias runtest)
 (action (diff check_transitional.expected check_transitional.out)))

(rule
 (alias runtest)
 (action (diff check_transitional_notes.expected check_transitional.err)))

