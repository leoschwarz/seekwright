verdict= accept
wire= {"requested_url":"https://e.com","status_code":200,"truncated":false,"url":"https://e.com/"}
verdict= accept
wire= {"offset":3,"text":"span"}
verdict= accept
wire= {"base64":"aGk=","byte_count":2}
