; The seal holds a second way round, with the private module already in scope:
; the call wants a bounds record nothing outside [lib/caps] can produce. This is
; the half that survives inside the workspace, where dune's own build does resolve
; a private module.
; raw_fs_call_needs_bounds
(rule
 (targets raw_fs_call_needs_bounds.out)
 (deps raw_fs_call_needs_bounds.ml error.cmi event.cmi budget.cmi controls_raw.cmi tool.cmi policy_fs.cmi policy_net.cmi authority.cmi policy.cmi registry.cmi server.cmi mcp_caps.cmi)
 (action
  (with-accepted-exit-codes
   (not (or 0))
   (with-outputs-to raw_fs_call_needs_bounds.out
    (run sh -c
     "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -c raw_fs_call_needs_bounds.ml 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'")))))

; The positive half: the intended grant path still type-checks for a consumer of
; the package, so the seal above is a seal on the bypass and not on the seam. A
; clean compile is the pass condition, so the compared output is empty, and
; [with-accepted-exit-codes] is the other way round from the negative rules: here
; a zero exit code is what is required.
; grant_path
(rule
 (targets grant_path.out)
 (deps grant_path.ml error.cmi event.cmi budget.cmi controls_raw.cmi tool.cmi policy_fs.cmi policy_net.cmi authority.cmi policy.cmi registry.cmi server.cmi mcp_caps.cmi)
 (action
  (with-accepted-exit-codes
   (or 0)
   (with-outputs-to grant_path.out
    (run sh -c
     "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -c grant_path.ml 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'")))))

(rule
 (alias runtest)
 (action
  (progn
   (diff no_grant_label.expected no_grant_label.out)
   (diff mint_grant.expected mint_grant.out)
   (diff forge_confinement.expected forge_confinement.out)
   (diff grant_type_mismatch.expected grant_type_mismatch.out)
   (diff confinement_is_not_a_grant.expected confinement_is_not_a_grant.out)
   (diff mcp_kit_result.expected mcp_kit_result.out)
   (diff direct_fs_operation.expected direct_fs_operation.out)
   (diff direct_net_operation.expected direct_net_operation.out)
   (diff controls_none.expected controls_none.out)
   (diff controls_record_forge.expected controls_record_forge.out)
   (diff controls_record_update.expected controls_record_update.out)
   (diff raw_fs_call_needs_bounds.expected raw_fs_call_needs_bounds.out)
   (diff grant_path.expected grant_path.out))))
