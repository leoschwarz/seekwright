; Programs that must not compile, and the diagnostic each one has to produce.
;
; These pin the layer's structural claims, which no positive test can: a tool
; cannot be registered without naming its grant, a grant cannot be built or
; taken apart outside Policy, one tool's power cannot be swapped for another's,
; and mcp-kit's result shape is not what a tool returns
; (plans/capability-gated-mcp-server.md §2, §4, §8). Each snippet is type-checked
; against the library's interfaces and its whole diagnostic is compared with
; <name>.expected, so an interface change that would let one of these compile
; fails the build here instead of waiting for review. Re-bless with
; [dune promote] when a diagnostic changes for a reason the snippet's own
; comment still describes.
;
; The compile is a plain [ocamlfind ocamlc] over [lib/caps]'s interfaces rather
; than a dune stanza, because a stanza that does not compile fails the build
; instead of reporting a diff. Two consequences show up below: the interfaces are
; copied in first, since [ocamlc] writes a [.cmi] next to its input and dune
; needs every output declared as a target; and [mcp_caps.ml] mirrors the alias
; module dune generates for the wrapped library — the {e package's} view, which
; leaves out the two private modules because their interfaces are filed under
; [.private/] and out of a consumer's search path. A consumer of the installed
; package gets "an alias for module ..., which is missing" for those names, and
; the mirror produces the shorter form of the same fact: no such name. The
; snippets read like the client code they stand for, and a snippet that reaches
; past the seal fails for the same reason a consumer of the package would. The
; interface list is in dependency order, because [ocamlc] compiles its arguments
; left to right and does no dependency analysis of its own; a module missing from
; it fails a snippet loudly, not silently.
;
; The mirror is the one thing here that a dune field could not give us. Inside
; this workspace the generated alias module does re-export the private modules,
; so [Mcp_caps.Policy_fs] resolves for a neighbouring stanza and no dune setting
; changes that ([root_module] aliases a library's {e dependencies}, not its own
; modules). Within the checkout the seal is a rule kept by
; [test/test_caps_audit.ml]; these snippets pin the package's boundary, which is
; where a consumer would actually meet it.
;
; [controls_raw] has no interface of its own — that is what makes the bounds
; record private to the library — so its signature is asked of the implementation
; with [ocamlc -i], which is exactly what dune does for the library's own siblings
; (see the second rule below). It is not aliased into [mcp_caps.ml], and the
; negative programs that name [Mcp_caps.Controls] or [Mcp_caps.Policy_fs] fail
; because the package has no such name.
;
; The [sed] in each compile drops this switch's packaging noise (the two [seq]
; definitions warning, and the [ptime.clock.os] deprecation the TLS stack pulls in)
; so it stays out of the compared text; it is [sed] rather than [grep] because
; [grep] exits 1 when it filters everything away, which would read as a compiler
; failure on a clean run. [set -o pipefail] is what keeps the
; compiler's own exit code — the half that says a snippet did not compile — and
; [with-accepted-exit-codes] turns "it compiled" into a build failure. The
; interface closure is repeated in each [deps] because the project's dune lang
; version has no user-defined variables to name it once.

(rule
 (targets error.cmi event.cmi budget.cmi)
 (deps ../../lib/caps/error.mli ../../lib/caps/event.mli
  ../../lib/caps/budget.mli)
 (action
  (progn
   (copy ../../lib/caps/error.mli error.mli) (copy ../../lib/caps/event.mli event.mli) (copy ../../lib/caps/budget.mli budget.mli)
   (run sh -c
    "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -c error.mli event.mli budget.mli 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'"))))

; The bounds record's module is private and has no [.mli]. Dune hands the library's
; own siblings the implementation signature; so does this, by asking [ocamlc -i] for
; it. [policy_fs.mli] and [policy_net.mli] are written against that type, so the
; mirror needs it to type-check the public interfaces — and it stays out of
; [mcp_caps.ml], because the package does not ship it.
(rule
 (targets controls_raw.mli)
 (deps ../../lib/caps/controls_raw.ml error.cmi event.cmi budget.cmi)
 (action
  (with-outputs-to controls_raw.mli
   (run sh -c
    "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -i ../../lib/caps/controls_raw.ml 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'"))))

(rule
 (targets controls_raw.cmi tool.cmi policy_fs.cmi policy_net.cmi authority.cmi policy.cmi registry.cmi server.cmi mcp_caps.cmi)
 (deps (glob_files ../../lib/caps/*.mli) mcp_caps.ml controls_raw.mli error.cmi event.cmi budget.cmi)
 (action
  (progn
   (copy ../../lib/caps/tool.mli tool.mli) (copy ../../lib/caps/policy_fs.mli policy_fs.mli) (copy ../../lib/caps/policy_net.mli policy_net.mli) (copy ../../lib/caps/authority.mli authority.mli) (copy ../../lib/caps/policy.mli policy.mli) (copy ../../lib/caps/registry.mli registry.mli) (copy ../../lib/caps/server.mli server.mli)
   (run sh -c
    "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -c controls_raw.mli tool.mli policy_fs.mli policy_net.mli authority.mli policy.mli registry.mli server.mli mcp_caps.ml 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'"))))

; A tool registered with its grant named, and the same call with the label
; dropped: the second is the one that must not type-check.
; no_grant_label
(rule
 (targets no_grant_label.out)
 (deps no_grant_label.ml error.cmi event.cmi budget.cmi controls_raw.cmi tool.cmi policy_fs.cmi policy_net.cmi authority.cmi policy.cmi registry.cmi server.cmi mcp_caps.cmi)
 (action
  (with-accepted-exit-codes
   (not (or 0))
   (with-outputs-to no_grant_label.out
    (run sh -c
     "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -c no_grant_label.ml 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'")))))

; The grant type has no public constructor, so it cannot be minted by the code
; that holds it.
; mint_grant
(rule
 (targets mint_grant.out)
 (deps mint_grant.ml error.cmi event.cmi budget.cmi controls_raw.cmi tool.cmi policy_fs.cmi policy_net.cmi authority.cmi policy.cmi registry.cmi server.cmi mcp_caps.cmi)
 (action
  (with-accepted-exit-codes
   (not (or 0))
   (with-outputs-to mint_grant.out
    (run sh -c
     "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -c mint_grant.ml 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'")))))

; The confinement witness is abstract, so [Authority.Fs.of_confinement] is not
; a way to build a grant.
; forge_confinement
(rule
 (targets forge_confinement.out)
 (deps forge_confinement.ml error.cmi event.cmi budget.cmi controls_raw.cmi tool.cmi policy_fs.cmi policy_net.cmi authority.cmi policy.cmi registry.cmi server.cmi mcp_caps.cmi)
 (action
  (with-accepted-exit-codes
   (not (or 0))
   (with-outputs-to forge_confinement.out
    (run sh -c
     "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -c forge_confinement.ml 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'")))))

; A tool that needs the filesystem cannot be registered with the network
; power: the two grants are different types, not two spellings of one.
; grant_type_mismatch
(rule
 (targets grant_type_mismatch.out)
 (deps grant_type_mismatch.ml error.cmi event.cmi budget.cmi controls_raw.cmi tool.cmi policy_fs.cmi policy_net.cmi authority.cmi policy.cmi registry.cmi server.cmi mcp_caps.cmi)
 (action
  (with-accepted-exit-codes
   (not (or 0))
   (with-outputs-to grant_type_mismatch.out
    (run sh -c
     "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -c grant_type_mismatch.ml 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'")))))

; M3's split between a decision and a grant: [Policy.with_endpoints] hands back
; the endpoint {e decision}, and registering that (rather than the grant
; [Authority.Net.of_confinement] makes from it) is what must not type-check.
; confinement_is_not_a_grant
(rule
 (targets confinement_is_not_a_grant.out)
 (deps confinement_is_not_a_grant.ml error.cmi event.cmi budget.cmi controls_raw.cmi tool.cmi policy_fs.cmi policy_net.cmi authority.cmi policy.cmi registry.cmi server.cmi mcp_caps.cmi)
 (action
  (with-accepted-exit-codes
   (not (or 0))
   (with-outputs-to confinement_is_not_a_grant.out
    (run sh -c
     "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -c confinement_is_not_a_grant.ml 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'")))))

; The core's output type is not mcp-kit's, so the transport's result shape
; cannot become what a tool is allowed to return.
; mcp_kit_result
(rule
 (targets mcp_kit_result.out)
 (deps mcp_kit_result.ml error.cmi event.cmi budget.cmi controls_raw.cmi tool.cmi policy_fs.cmi policy_net.cmi authority.cmi policy.cmi registry.cmi server.cmi mcp_caps.cmi)
 (action
  (with-accepted-exit-codes
   (not (or 0))
   (with-outputs-to mcp_kit_result.out
    (run sh -c
     "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -c mcp_kit_result.ml 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'")))))

; F1.2's seal, one program per way the raw operations used to be reachable. The
; first two name the operations themselves; the next three name the bounds record
; they take, which is the argument no consumer can fill.
; direct_fs_operation
(rule
 (targets direct_fs_operation.out)
 (deps direct_fs_operation.ml error.cmi event.cmi budget.cmi controls_raw.cmi tool.cmi policy_fs.cmi policy_net.cmi authority.cmi policy.cmi registry.cmi server.cmi mcp_caps.cmi)
 (action
  (with-accepted-exit-codes
   (not (or 0))
   (with-outputs-to direct_fs_operation.out
    (run sh -c
     "set -o pipefail; ocamlfind ocamlc -I . -package eio,mcp-kit,uri,yojson,http,cohttp-eio,ipaddr,domain-name,tls,tls-eio,ca-certs,mirage-crypto-rng -c direct_fs_operation.ml 2>&1 | sed -n '/^findlib:/d; /^ocamlfind: \\[WARNING\\]/d;p'")))))

