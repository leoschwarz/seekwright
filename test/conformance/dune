; The official-runner fixture (README.md). It is an executable, not a test,
; because the pinned runner drives it over loopback HTTP from outside the build;
; keeping it in the default build is what makes "the fixture still compiles" part
; of the gate.

(executable
 (name fixture)
 (libraries
  mcp-caps
  mcp-kit
  mcp-kit.stdio
  mcp-kit-cohttp-eio
  cohttp-eio
  eio
  eio_main))

; The stdio half of the conformance evidence. The official runner has no stdio
; mode — `conformance server` takes `--url` and nothing else — so the JSON-RPC
; bodies its scenarios send over Streamable HTTP are replayed here through a real
; stdio session and the answers are blessed as a diff. Same fixture binary, same
; declarations, same bodies as the live run recorded in README.md; only the
; framing differs (plans/capability-gated-mcp-server.md §7).
;
; [transcript.jsonl] and [root/note.txt] are committed rather than generated by
; the rule: the bodies are the thing being pinned, and [test_read_granted_file]
; needs a filesystem root whose contents a reader can see.
; [with-outputs-to] merges both streams, so the two are split explicitly: the
; transcript is the protocol channel and the notes are the startup surface, and
; pinning both is what keeps "stdout is JSON-RPC only" (§7) checked here instead
; of asserted in prose.
(rule
 (deps
  fixture.exe
  transcript.jsonl
  (glob_files root/*))
 (targets stdio_transcript.out stdio_transcript_notes.out)
 (action
  (with-accepted-exit-codes
   0
   (with-stderr-to stdio_transcript_notes.out
    (with-stdout-to stdio_transcript.out
     (run sh -c "cat transcript.jsonl | ./fixture.exe --root root --stdio"))))))

(rule
 (alias runtest)
 (action (diff stdio_transcript.expected stdio_transcript.out)))

(rule
 (alias runtest)
 (action (diff stdio_transcript_notes.expected stdio_transcript_notes.out)))
