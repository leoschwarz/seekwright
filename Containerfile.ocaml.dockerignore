# Ignore rules for Containerfile.ocaml. BuildKit picks this file up by name for
# `docker build -f Containerfile.ocaml .`; for podman pass it explicitly:
# `--ignorefile=Containerfile.ocaml.dockerignore`, whose own default is not this
# file. The context this build needs is lib/ and bin/ plus the two opam manifests
# with their locks and the dune files.
.git/
.gitignore
.github/
.opam/
_build/
**/_build/
**/_build/**
# A checkout from before the Python tree's deletion can still carry these; nothing
# in the surviving tree writes them, and .venv is the large one.
.venv/
.pytest_cache/

# Pages, notes and skills: prose this build cannot consume.
ocaml-docs/
deploy/
skills/
plans/
README.md
AGENTS.md
CLAUDE.md
SECURITY.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md

# Neither the OCaml @install alias nor the shipped artifact touches these: the
# suites, the live harness, the repo instruments and the examples all stay on
# the developer's machine, which is what keeps a published image free of
# test-only material.
test/
live/
ocaml-tools/
examples/

.agents/
.research/
.eval/
node_modules/
**/node_modules/
VISION.md
