# Copy to .env here. Compose reads it for the ${…} substitutions in compose.yaml; no key belongs
# in this file (those come from search.env). Gitignored, like search.env.

# The address both listeners are published on -- the access control, since nothing authenticates
# them. Name one interface address, never 0.0.0.0: that publishes everywhere, and the Host
# allowlist then answers 421 Invalid Host header for every client.
SEEKWRIGHT_PUBLISH=127.0.0.1

# The published image tag both roles run. Pinned rather than a moving `latest`: the release lane
# publishes the tag name and nothing else. `docker compose up --build` ignores it for a local build.
SEEKWRIGHT_TAG=v0.1.0

# Unset or `lenient`: refuse the sinks in egress/deny-hosts.txt, allow other public hosts. `strict`:
# allow only egress/fetch-allow-hosts.txt -- fill in its operator tail first, or every page is refused.
#EGRESS_FETCH_POLICY=strict
