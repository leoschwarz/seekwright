; The seekwright executable: the server on either transport, the [--check] /
; [--metrics] diagnoses, and the three client verbs over the REST projection.
; P8 owns this file. The loop runner and the RNG installer belong here, not in
; any library: [Eio_main]'s interface says a library must not call [run], and
; [mirage-crypto-rng.unix] pulls stdlib [unix], which the libraries keep out.
(executable
 (name main)
 (public_name seekwright)
 (package seekwright)
 (libraries
  seekwright
  seekwright.cli
  seekwright.factory
  seekwright.providers
  seekwright.fetch
  seekwright.fetch.stdlib
  mcp-caps
  mcp-kit
  mcp-kit.stdio
  mcp-kit-cohttp-eio
  cohttp-eio
  http
  eio
  eio_main
  uri
  yojson
  cstruct
  ipaddr
  tls
  tls-eio
  ca-certs
  mirage-crypto-rng.unix
  unix))

; The [--check] diagnosis over a deployment that asks only for names this port
; does not carry. Nothing is built here, so nothing is dialled: the run reaches
; no provider endpoint, which is what lets a diagnosis be a test at all. The
; pinned stdout is [--check]'s five-set distinction — enabled, effective, built,
; skipped, untested, and the per-name rows that say "not built on this port" —
; and the exit code is the problem count, so the rule accepts 1, not 0.
(rule
 (deps main.exe check_unbuilt.toml)
 (targets check_unbuilt.out check_unbuilt.err)
 (action
  (with-accepted-exit-codes
   (or
    1
    (not 0))
   (with-stderr-to check_unbuilt.err
    (with-stdout-to check_unbuilt.out
     (run
      sh
      -c
      "SEEKWRIGHT_CONFIG=check_unbuilt.toml ./main.exe --check"))))))

(rule
 (alias runtest)
 (action (diff check_unbuilt.expected check_unbuilt.out)))

; A diagnosis writes to stdout only: stderr stays empty, which is the same
; discipline the stdio smoke pins for the serving path, and it means a traceback
; or a startup log line in [--check] fails the run.
(rule
 (alias runtest)
 (action (diff check_unbuilt_notes.expected check_unbuilt.err)))

; The stdio smoke: a scripted legacy JSON-RPC session (initialize,
; notifications/initialized, tools/list) piped through the real binary, with
; the config pointed at a path that does not exist so the keyless defaults are
; what runs. The protocol answers are blessed; the startup notes on stderr are
; pinned separately so "stdout is JSON-RPC only" stays checked.
(rule
 (deps main.exe smoke.jsonl smoke.toml)
 (targets smoke.out smoke.err)
 (action
  (with-accepted-exit-codes
   0
   (with-stderr-to smoke.err
    (with-stdout-to smoke.out
     (run
      sh
      -c
      "SEEKWRIGHT_CONFIG=smoke.toml sh -c 'cat smoke.jsonl | ./main.exe'"))))))

(rule
 (alias runtest)
 (action (diff smoke.expected smoke.out)))

(rule
 (alias runtest)
 (action (diff smoke_notes.expected smoke.err)))
