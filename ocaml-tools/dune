; The OCaml surface printer (P8): root [tools/] belongs to the read-only
; Python tree, so the port's instrument lives here. It prints the frozen
; manifest in the same body format [tools/surface.py] prints, and the two
; goldens below are what make drift fail [dune runtest]:
;
; - [surface.expected] is the full rendering (the Python-compatible body plus
;   the usage-journal fields) diffed against the printer's output;
; - the [py_body.out]/[our_body.out] pair diffs the Python-compatible body
;   against the body of the checked-in [../docs/reference/surface.md], which
;   is the "the two manifests diff clean" exit criterion.
(executable
 (name surface)
 (libraries seekwright))

(rule
 (targets surface.actual)
 (deps surface.exe ../lib/config.mli)
 (action (with-outputs-to surface.actual (run ./surface.exe))))

(rule
 (alias runtest)
 (action (diff surface.expected surface.actual)))

(rule
 (targets py_body.out)
 (deps ../docs/reference/surface.md)
 (action
  (with-outputs-to py_body.out
   (run sh -c "awk 'f{print} /<!-- surface:body -->/{f=1}' ../docs/reference/surface.md"))))

(rule
 (targets our_body.out)
 (deps surface.exe ../lib/config.mli)
 (action (with-outputs-to our_body.out (run ./surface.exe --python-body))))

(rule
 (alias runtest)
 (action (diff py_body.out our_body.out)))

; The embedded-prose pins (M8). Each literal in [lib/] is a copy of a
; read-only file under [../src/seekwright/resources/]; these rules print the
; literal and diff it against the original, so a drift in either direction
; fails [dune runtest] instead of waiting for a reader to notice two
; deployments phrasing one rule differently.
(executable
 (name resources)
 (libraries seekwright))

(rule
 (targets server_instructions.out)
 (deps resources.exe)
 (action (with-outputs-to server_instructions.out (run ./resources.exe server_instructions))))

(rule
 (alias runtest)
 (action (diff ../src/seekwright/resources/server_instructions.txt server_instructions.out)))

(rule
 (targets search_description.out)
 (deps resources.exe)
 (action (with-outputs-to search_description.out (run ./resources.exe search_description))))

(rule
 (alias runtest)
 (action (diff ../src/seekwright/resources/search_description.txt search_description.out)))

(rule
 (targets fetch_description.out)
 (deps resources.exe)
 (action (with-outputs-to fetch_description.out (run ./resources.exe fetch_description))))

(rule
 (alias runtest)
 (action (diff ../src/seekwright/resources/fetch_description.txt fetch_description.out)))

(rule
 (targets answer_description.out)
 (deps resources.exe)
 (action (with-outputs-to answer_description.out (run ./resources.exe answer_description))))

(rule
 (alias runtest)
 (action (diff ../src/seekwright/resources/answer_description.txt answer_description.out)))

(rule
 (targets answer_system.out)
 (deps resources.exe)
 (action (with-outputs-to answer_system.out (run ./resources.exe answer_system))))

(rule
 (alias runtest)
 (action (diff ../src/seekwright/resources/answer_system.txt answer_system.out)))

(rule
 (targets dashboard.out)
 (deps resources.exe)
 (action (with-outputs-to dashboard.out (run ./resources.exe dashboard))))

(rule
 (alias runtest)
 (action (diff ../src/seekwright/resources/dashboard.html dashboard.out)))
