# dune's build tree: never committable.
_build/

# The pinned official conformance runner's Node modules: rendered from
# test/conformance/package-lock.json by `npm ci`, never committed (that directory's
# README.md names the version it was rendered at).
test/conformance/node_modules/

# The usage journal the suites write: [test/test_usage.ml] and
# [test/test_p8_surface.ml] name it relative to the working directory, so a run
# started from the tree root leaves it here.
usage-journal/
p8-surface-journal/

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
pytest-of-*/
dist/
*.db
*.db-wal
*.db-shm

# Private: internal hostnames, runbook detail, caller content.
deploy/*
# One exception, one subtree: the compose unit set and the lists CI renders into it.
# The private rule stays whole everywhere else under `deploy/`, so an operator snapshot cannot
# become a stray unignored file the way five sub-path exceptions would let it.
!deploy/compose/
# The operator's own values in the shipped bundle; the `.example` files stay tracked.
deploy/compose/.env
deploy/compose/search.env
docs/internal/

.eval/

.research/

# `.eval/`, `.research/`, `.agents/` are mirrored in `.containerignore`.
.agents/*

# ocaml-port branch: the project skill is committed; the rest of .agents/ stays ignored
!.agents/skills/
